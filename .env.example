# Скопируйте этот файл в .env и впишите свои значения из Supabase
# SUPABASE_URL = Project Settings -> API -> Project URL
# SUPABASE_SERVICE_KEY = Project Settings -> API -> service_role secret (НЕ public!)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...service_role...
ADMIN_PASSWORD=придумайте-пароль-для-админки
PORT=3000
